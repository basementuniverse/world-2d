{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "removeComments": false,
    "sourceMap": false,
    "rootDir": "./src",
    "outDir": "./build/"
  },
  "include": [
    "src/index.ts",
    "src/core/**/*",
    "src/lighting/**/*",
    "src/reflections/**/*",
    "src/world/**/*"
  ]
}
